root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,cs}]
indent_style = space
indent_size = 4

[*.{json,toml,yaml,yml,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{slnx,csproj,props}]
indent_style = space
indent_size = 2
