<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>KittenIO</AssemblyName>
    <RootNamespace>KittenIO.Mod</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <KsaDir Condition="'$(KsaDir)' == ''">$(LocalAppData)\Programs\Kitten Space Agency</KsaDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KittenIO.Protocol\KittenIO.Protocol.csproj" />
    <Reference Include="KSA">
      <HintPath>$(KsaReferencePath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.ImGui.Abstractions">
      <HintPath>$(KsaDir)\Brutal.ImGui.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.ImGui">
      <HintPath>$(KsaDir)\Brutal.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Numerics">
      <HintPath>$(KsaDir)\Brutal.Core.Numerics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Strings">
      <HintPath>$(KsaDir)\Brutal.Core.Strings.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepuUtilities">
      <HintPath>$(KsaDir)\BepuUtilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- StarMap is a read-only development input. Consume its prebuilt Debug API
       assembly without building or copying the external checkout. -->
  <ItemGroup>
    <Reference Include="StarMap.API">
      <HintPath>$(StarMapApiPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="mod.toml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
