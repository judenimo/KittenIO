<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>KittenIO.Mod.Tests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <KsaDir Condition="'$(KsaDir)' == ''">$(LocalAppData)\Programs\Kitten Space Agency</KsaDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KittenIO.Mod\KittenIO.Mod.csproj" />
    <ProjectReference Include="..\..\src\KittenIO.Protocol\KittenIO.Protocol.csproj" />
    <Reference Include="KSA">
      <HintPath>$(KsaReferencePath)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Brutal.Core.Numerics">
      <HintPath>$(KsaDir)\Brutal.Core.Numerics.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="StarMap.API">
      <HintPath>$(StarMapApiPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
